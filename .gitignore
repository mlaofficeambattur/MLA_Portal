# ============================================================
# SECRETS & ENVIRONMENT VARIABLES  ← NEVER commit these
# ============================================================
.env
.env.local
.env.development
.env.production
.env.staging
# Allow only the safe template files
!.env.example
!backend/.env.example
!frontend/.env.example

# ============================================================
# INTERNAL / CONFIDENTIAL MARKDOWN DOCS  ← Not for public
# Block all .md files first, then allow only README
# ============================================================
*.md
!README.md
changes.md
# ============================================================
