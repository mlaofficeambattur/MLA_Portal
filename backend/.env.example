# ============================================================
# BACKEND ENVIRONMENT VARIABLES — TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Supabase PostgreSQL Pooler Connection ---
DB_HOST=your-database-host.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-supabase-project-id
DB_PASS=your-database-password

# --- FastAPI JWT Authentication ---
# Use a long, random, cryptographically secure string (minimum 32 chars)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-strong-random-secret-key

# --- Supabase Storage & Auth ---
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- SMS Notifications (Optional) ---
# Set SMS_PROVIDER=msg91 to enable real SMS. Defaults to 'mock' (prints to console).
SMS_PROVIDER=mock
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=MLAPTL
MSG91_TEMPLATE_ID=your-template-id
MSG91_ROUTE=4
